{
  // API local contra la base de PRODUCCIÓN de Railway: ASPNETCORE_ENVIRONMENT=LocalNube.
  //
  // De los user-secrets solo se toma ConnectionStrings:Default (ver Program.cs); el
  // resto (R2, Resend, Jwt) no se carga:
  //   - Correo: LoggingEmailSender (los enlaces salen en la consola, no se envían).
  //   - Archivos: deshabilitados.
  //   - Sin migraciones ni semilla al arrancar: la base la migra el deploy de Railway.
  // Todo lo que se cree desde aquí es REAL y lo ven los miembros.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "boeshiri-api",
    "Audience": "boeshiri-web",
    // Clave solo para este equipo: los tokens no sirven contra la API de producción.
    "Key": "clave-local-nube-boeshiri-no-usar-en-produccion-0123456789abcdef",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
