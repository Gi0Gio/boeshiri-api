{
  // Entorno de pruebas local: ASPNETCORE_ENVIRONMENT=Local.
  //
  // En este entorno .NET NO carga los user-secrets (solo se cargan en Development),
  // así que la API no puede llegar a la base de Railway, al bucket de R2 ni a Resend
  // aunque esos secretos sigan configurados en este equipo:
  //   - Base: el Postgres nativo de este equipo (localhost:5432).
  //   - Correo: LoggingEmailSender (los enlaces salen en la consola, no se envían).
  //   - Archivos: deshabilitados (subir imágenes/documentos responde error).
  // Al arrancar se crean cuentas de prueba (DevUsersSeeder). Ver README.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=boeshiri;Username=boeshiri;Password=boeshiri_dev"
  },
  "Jwt": {
    "Issuer": "boeshiri-api",
    "Audience": "boeshiri-web",
    // Clave solo para pruebas locales: no protege nada real.
    "Key": "clave-local-de-pruebas-boeshiri-no-usar-en-produccion-0123456789",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Database": {
    "SeedDevUsers": true
  }
}
